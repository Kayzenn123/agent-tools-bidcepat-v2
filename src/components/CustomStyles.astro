---
// Palet BidCepat (seed 2026-10-16): light, triadic, baseHue 104.
// --bg kertas krem kehijauan, --pop merah cap pos, --accent biru tinta.
// Batasan seed "hanya garis tanpa fill": permukaan memakai garis tepi,
// bukan fill berwarna.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-body);
    --aw-font-serif: var(--font-body);
    --aw-font-heading: var(--font-display);

    --aw-color-primary: oklch(0.52 0.19 224); /* biru tinta */
    --aw-color-secondary: oklch(0.45 0.16 224);
    --aw-color-accent: oklch(0.55 0.2 344); /* magenta */

    --aw-color-text-heading: oklch(0.2 0.04 104);
    --aw-color-text-default: oklch(0.24 0.035 104);
    --aw-color-text-muted: oklch(0.45 0.03 104);
    --aw-color-bg-page: oklch(0.96 0.037 104); /* kertas krem kehijauan */

    --aw-color-bg-page-dark: oklch(0.96 0.037 104);

    /* Token khas BidCepat */
    --bc-paper: oklch(0.96 0.037 104);
    --bc-surface: oklch(0.92 0.045 104);
    --bc-line: oklch(0.32 0.05 104); /* garis tinta */
    --bc-pop: oklch(0.52 0.21 30); /* merah cap pos */
    --bc-ink-blue: oklch(0.52 0.19 224);
    --bc-ink-magenta: oklch(0.55 0.2 344);

    --ease-standard: cubic-bezier(0.2, 0, 0, 1);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);

    ::selection {
      background-color: oklch(0.52 0.21 30 / 0.25);
    }
  }
</style>
